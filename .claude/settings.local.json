{
  "permissions": {
    "allow": [
      "Bash(npx gsd-core *)",
      "Read(.planning/*)",
      "Edit(.planning/*)",
      "Read(STATE.md)",
      "Edit(STATE.md)",
      "WebSearch",
      "Bash(python3 -c \"print\\(1\\)\")",
      "Bash(python -c \"print\\(1\\)\")",
      "Bash(cat)",
      "Read(//tmp/**)",
      "Bash(chmod +x /home/myothet/repos/vct/zach-hair-studio/.claude/hooks/*.sh)",
      "Bash(dotnet user-secrets *)",
      "Bash(openssl rand *)",
      "Skill(gsd-quick)",
      "Skill(gsd-quick:*)",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_type",
      "Skill(gsd-fast)",
      "Skill(gsd-fast:*)",
      "PowerShell(Stop-Process -Id 17284 -Force -Confirm:$false)",
      "PowerShell(npx -y openapi-typescript http://localhost:5236/openapi/v1.json -o lib/api/schema.d.ts)",
      "PowerShell(Remove-Item -Recurse -Force \"lib\" -Confirm:$false)",
      "PowerShell(Remove-Item -Force \"dashboard\\\\lib\\\\adminChat.test.mjs\" -Confirm:$false)",
      "PowerShell($assembly = [System.Reflection.Assembly]::LoadFrom\\(\"$env:USERPROFILE\\\\.nuget\\\\packages\\\\openai\\\\2.12.0\\\\lib\\\\net10.0\\\\OpenAI.dll\"\\); $factory = $assembly.GetType\\('OpenAI.Chat.OpenAIChatModelFactory'\\); $factory.GetMethods\\(\\) | Where-Object { $_.Name -in @\\('ChatCompletion','ChatTokenUsage','ChatToolCall'\\) } | ForEach-Object { \"METHOD $\\($_.Name\\)\"; $_.GetParameters\\(\\) | ForEach-Object { \"  $\\($_.ParameterType.FullName\\) $\\($_.Name\\) optional=$\\($_.IsOptional\\) default=$\\($_.DefaultValue\\)\" } }; $toolCall = $assembly.GetType\\('OpenAI.Chat.ChatToolCall'\\); $toolCall.GetMethods\\(\\) | Where-Object { $_.Name -eq 'CreateFunctionToolCall' } | ForEach-Object { \"METHOD $\\($_.Name\\)\"; $_.GetParameters\\(\\) | ForEach-Object { \"  $\\($_.ParameterType.FullName\\) $\\($_.Name\\) optional=$\\($_.IsOptional\\) default=$\\($_.DefaultValue\\)\" } })"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.secrets)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "disabledMcpjsonServers": [
    "sqlite",
    "context7",
    "github"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-check-update.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-context-monitor.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-read-injection-scanner.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-graphify-update.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-prompt-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-read-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-workflow-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-worktree-path-guard.js",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-context-monitor.js",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-context-monitor.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-context-monitor.js",
            "timeout": 10
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "config.json",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-config-reload.js",
            "timeout": 8
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": false
  }
}
